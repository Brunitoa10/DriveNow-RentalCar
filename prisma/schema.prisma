// DriveNow v2 — esquema de datos
// Después de reemplazar este archivo:  npx prisma migrate dev --name drivenow_v2  &&  npx prisma db seed

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

enum CarCategory {
  SEDAN
  SUV
  DEPORTIVO
  LUJO
  COMPACTO
  PICKUP
}

enum Transmission {
  MANUAL
  AUTOMATICA
}

enum FuelType {
  NAFTA
  DIESEL
  HIBRIDO
  ELECTRICO
}

enum ReservationStatus {
  PENDING
  PAID
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DeliveryMode {
  BRANCH
  HOME
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  address   String
  city      String
  phone     String?
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cars     Car[]
  pickups  Reservation[] @relation("PickupBranch")
  dropoffs Reservation[] @relation("DropoffBranch")
}

model Car {
  id           String       @id @default(uuid())
  name         String
  brand        String
  year         Int
  category     CarCategory
  transmission Transmission
  fuel         FuelType
  seats        Int
  horsepower   Int
  engine       String
  pricePerDay  Decimal      @db.Decimal(10, 2)
  photo        String
  isPublished  Boolean      @default(false)
  mileageKm    Int          @default(0)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  // Última posición conocida (telemetría / check-in manual)
  lat Float?
  lng Float?

  reservations Reservation[]
  reviews      Review[]
  tripLogs     TripLog[]
  maintenances Maintenance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([isPublished])
}

model Reservation {
  id   String @id @default(uuid())
  code String @unique

  carId String
  car   Car    @relation(fields: [carId], references: [id], onDelete: Cascade)

  customerName  String
  customerEmail String
  customerPhone String

  startDate DateTime
  endDate   DateTime
  status    ReservationStatus @default(PENDING)

  deliveryMode    DeliveryMode @default(BRANCH)
  pickupBranchId  String?
  pickupBranch    Branch?      @relation("PickupBranch", fields: [pickupBranchId], references: [id], onDelete: SetNull)
  dropoffBranchId String?
  dropoffBranch   Branch?      @relation("DropoffBranch", fields: [dropoffBranchId], references: [id], onDelete: SetNull)
  deliveryAddress String?
  deliveryLat     Float?
  deliveryLng     Float?
  routeDistanceKm Float?
  routeDurationMin Float?

  days        Int
  pricePerDay Decimal @db.Decimal(10, 2)
  subtotal    Decimal @db.Decimal(10, 2)
  discount    Decimal @db.Decimal(10, 2) @default(0)
  deliveryFee Decimal @db.Decimal(10, 2) @default(0)
  total       Decimal @db.Decimal(10, 2)

  paymentProvider String?
  paymentRef      String?

  review  Review?
  tripLog TripLog?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([carId])
  @@index([customerEmail])
  @@index([status])
  @@index([pickupBranchId])
  @@index([dropoffBranchId])
}

model Review {
  id            String      @id @default(uuid())
  carId         String
  car           Car         @relation(fields: [carId], references: [id], onDelete: Cascade)
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  authorName  String
  overall     Int
  comfort     Int
  cleanliness Int
  performance Int
  efficiency  Int
  value       Int
  comment     String?

  createdAt DateTime @default(now())

  @@index([carId])
}

// Registro operativo de cada viaje: alimenta las métricas de performance
model TripLog {
  id            String       @id @default(uuid())
  carId         String
  car           Car          @relation(fields: [carId], references: [id], onDelete: Cascade)
  reservationId String?      @unique
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  distanceKm Float
  fuelUsedL  Float
  incidents  Int     @default(0)
  notes      String?
  recordedAt DateTime @default(now())

  @@index([carId])
}

model Maintenance {
  id          String    @id @default(uuid())
  carId       String
  car         Car       @relation(fields: [carId], references: [id], onDelete: Cascade)
  kind        String
  description String?
  cost        Decimal   @db.Decimal(10, 2)
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime  @default(now())

  @@index([carId])
}

# Base de datos (PostgreSQL)
DATABASE_URL="postgresql://usuario:password@localhost:5432/drivenow"

# URL pública del sitio (para redirecciones de pago)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Panel admin: clave de acceso (sin cuentas). Usá algo largo y aleatorio.
ADMIN_ACCESS_KEY="cambiame-por-una-clave-larga"
# Opcional: secreto para firmar la cookie (por defecto usa ADMIN_ACCESS_KEY)
ADMIN_SESSION_SECRET=""

# Pagos con Stripe (si se deja vacío, el sitio usa el modo demo con "Simular pago")
STRIPE_API_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Subida de fotos (UploadThing). Sin token, el admin puede pegar una URL.
UPLOADTHING_TOKEN=""

# Opcional: servidor OSRM propio para rutas (por defecto el público de OpenStreetMap)
OSRM_URL=""
